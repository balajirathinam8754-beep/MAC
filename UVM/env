class mac_env extends uvm_env;

    `uvm_component_utils(mac_env)

    mac_agent      agent;
    mac_scoreboard scoreboard;


    function new(
        string name = "mac_env",
        uvm_component parent = null
    );

        super.new(name, parent);

    endfunction


    function void build_phase(uvm_phase phase);

        super.build_phase(phase);

        agent =
            mac_agent::type_id::create(
                "agent",
                this
            );

        scoreboard =
            mac_scoreboard::type_id::create(
                "scoreboard",
                this
            );

    endfunction


    function void connect_phase(uvm_phase phase);

        agent.monitor.analysis_port.connect(
            scoreboard.analysis_export
        );

    endfunction

endclass
