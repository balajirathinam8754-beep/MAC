class mac_sequence_item extends uvm_sequence_item;

    rand bit signed [7:0] a;
    rand bit signed [7:0] b;

    rand bit en;
    rand bit clear;

    logic signed [15:0] acc;
    logic valid;

    `uvm_object_utils_begin(mac_sequence_item)
        `uvm_field_int(a, UVM_ALL_ON)
        `uvm_field_int(b, UVM_ALL_ON)
        `uvm_field_int(en, UVM_ALL_ON)
        `uvm_field_int(clear, UVM_ALL_ON)
        `uvm_field_int(acc, UVM_ALL_ON)
        `uvm_field_int(valid, UVM_ALL_ON)
    `uvm_object_utils_end

    function new(string name = "mac_sequence_item");
        super.new(name);
    endfunction

endclass
